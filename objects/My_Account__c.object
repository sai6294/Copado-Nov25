    <label>My Account</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>Email__c</columns>
        <columns>Balance__c</columns>
        <columns>CREATEDBY_USER</columns>
        <columns>Expiry_Date__c</columns>
        <columns>Mobile_Number__c</columns>
        <columns>OWNER.FIRST_NAME</columns>
        <columns>OWNER.LAST_NAME</columns>
        <filterScope>Everything</filterScope>
        <label>All</label>
    </listViews>
    <nameField>
        <label>My Account Name</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>MyAccounts</pluralLabel>
    <recordTypes>
        <fullName>Company_Account</fullName>
        <active>true</active>
        <label>Company Account</label>
        <picklistValues>
            <picklist>Account_Type__c</picklist>
            <values>
                <fullName>Corporate</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <recordTypes>
        <fullName>Individual_Account</fullName>
        <active>true</active>
        <label>Individual Account</label>
        <picklistValues>
            <picklist>Account_Type__c</picklist>
            <values>
                <fullName>Current</fullName>
                <default>false</default>
            </values>
            <values>
                <fullName>Savings</fullName>
                <default>false</default>
            </values>
        </picklistValues>
    </recordTypes>
    <searchLayouts/>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Account_Type_Should_Be_Required</fullName>
        <active>false</active>
        <errorConditionFormula>NOT( IFSC_Code__c  &lt;&gt; null)</errorConditionFormula>
        <errorDisplayField>IFSC_Code__c</errorDisplayField>
        <errorMessage>Please enter a value for IFSC Code</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Balance_Cannot_Be_Negative</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(Balance__c  &gt; 0)</errorConditionFormula>
        <errorMessage>Balance Must Be Greater Than Zero</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Email_Should_Be_Gmail</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(CONTAINS(Email__c, &apos;gmail&apos;))</errorConditionFormula>
        <errorDisplayField>Email__c</errorDisplayField>
        <errorMessage>Email must contain gmail</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>check_IFSC_Code</fullName>
        <active>false</active>
        <errorConditionFormula>NOT(REGEX(IFSC_Code__c ,&apos;^(?=.*[a-zA-Z])(?=.*[0-9])[A-Za-z0-9]+$&apos;))</errorConditionFormula>
        <errorDisplayField>IFSC_Code__c</errorDisplayField>
        <errorMessage>Please enter a alphanumeric value without any special characters</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
