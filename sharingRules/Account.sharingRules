<?xml version="1.0" encoding="UTF-8"?>
<SharingRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <sharingCriteriaRules>
        <fullName>Share_Accounts_With_Public_Group1</fullName>
        <accessLevel>Read</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Read</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <label>Share Accounts With Public Group1</label>
        <sharedTo>
            <group>Public_Group1</group>
        </sharedTo>
        <criteriaItems>
            <field>Rating</field>
            <operation>equals</operation>
            <value>Warm</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
    <sharingOwnerRules>
        <fullName>Share_records_owned_by_public_group1</fullName>
        <accessLevel>Read</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Read</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <label>Share records owned by public group1</label>
        <sharedTo>
            <role>MarketingTeam</role>
        </sharedTo>
        <sharedFrom>
            <group>Public_Group1</group>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>Share_records_owned_by_public_group2</fullName>
        <accessLevel>Read</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Read</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <label>Share records owned by public group2</label>
        <sharedTo>
            <role>EasternSalesTeam</role>
        </sharedTo>
        <sharedFrom>
            <group>Public_Group2</group>
        </sharedFrom>
    </sharingOwnerRules>
    <sharingOwnerRules>
        <fullName>share_accounts_owned_by_vp_international_sales</fullName>
        <accessLevel>Read</accessLevel>
        <accountSettings>
            <caseAccessLevel>None</caseAccessLevel>
            <contactAccessLevel>Read</contactAccessLevel>
            <opportunityAccessLevel>None</opportunityAccessLevel>
        </accountSettings>
        <label>share accounts owned by vp international sales</label>
        <sharedTo>
            <role>VPMarketing</role>
        </sharedTo>
        <sharedFrom>
            <role>VPInternationalSales</role>
        </sharedFrom>
    </sharingOwnerRules>
</SharingRules>
